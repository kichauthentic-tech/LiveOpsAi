{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "liveops-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3100,
      "autoPort": true,
      "env": {
        "PORT": "3100"
      }
    },
    {
      "name": "liveops-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "server.ts"
      ],
      "port": 3100,
      "env": {
        "PORT": "3100",
        "NODE_ENV": "production"
      }
    }
  ]
}
