GEMINI_API_KEY=
PORT=3000

# Supabase (Phase 0 — see supabase/migrations/0001_init.sql)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase service role key (Phase 4 — server-side ONLY, never VITE_-prefixed).
# Used by server.ts to invite/delete user accounts via the Supabase Admin API.
# Get it from Supabase dashboard > Project Settings > API > service_role secret.
# NEVER commit a real value or expose it to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# TikTok Shop Partner API (Phase 9 — server-side ONLY, never VITE_-prefixed).
# Get App Key/Secret from TikTok Shop Partner Center after app approval.
# TIKTOK_REDIRECT_URI must exactly match the redirect URL registered for the app
# (e.g. https://yourdomain.com/api/tiktok/oauth/callback).
# TIKTOK_WEBHOOK_SECRET is the shared secret configured for the webhook subscription —
# leave empty during initial testing (signature check is skipped when unset).
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_WEBHOOK_SECRET=

# Sentry error tracking (Phase 11). Get a DSN by creating a project at sentry.io
# (Platform: Node for the server one, React for the client one — can be the same
# project or two separate ones). Leave both empty to disable error tracking entirely
# — the app behaves identically either way.
SENTRY_DSN=
VITE_SENTRY_DSN=
